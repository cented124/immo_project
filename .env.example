# Copy to .env, generate independent strong secrets; never commit .env.
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
DATABASE_URL=postgresql+psycopg://raumwerk:replace-with-url-safe-random-secret@db:5432/raumwerk
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
DATA_DIR=/data
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=0
API_INTERNAL_URL=http://api:8000
DELIVERY_WORKER=1
# In production use HTTPS, exact PUBLIC_ORIGIN and COOKIE_SECURE=1.
# SMTP/Telegram credentials are entered in the protected admin interface.
